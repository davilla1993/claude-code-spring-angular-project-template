# Copier en .env (non versionné). Utilisé par docker-compose et lu par le backend via les variables d'environnement.

# --- Base de données ---
DB_NAME=project_db
DB_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/project_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

# --- Emails (MailHog en local) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAILHOG_HTTP_PORT=8025
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=TemplateApp

# --- Backend ---
BACKEND_PORT=8080
# Obligatoire hors profil dev : au moins 32 caractères aléatoires (ex : openssl rand -base64 48)
JWT_SECRET=change_me_to_a_very_long_random_string_for_production
CORS_ALLOWED_ORIGINS=http://localhost:4200
COOKIE_SECURE=true
REGISTRATION_ENABLED=true
UPLOADS_DIR=./uploads

# --- Frontend ---
FRONTEND_PORT=4200
