# Variables d'environnement du profil "prod" (application-prod.yml) — à configurer sur le serveur.
# Les variables sans valeur par défaut dans application-prod.yml sont obligatoires.
SPRING_PROFILES_ACTIVE=prod

# --- Base de données ---
DATABASE_URL=jdbc:postgresql://db-host:5432/template_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# --- Emails (SMTP) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=TemplateApp

# --- Backend ---
BACKEND_PORT=8080
# Obligatoire hors profil dev : au moins 32 caractères aléatoires (ex : openssl rand -base64 48)
JWT_SECRET=change_me_to_a_very_long_random_string_for_production
CORS_ALLOWED_ORIGINS=https://app.example.com
REGISTRATION_ENABLED=true
UPLOADS_DIR=/var/lib/app/uploads
# Optionnel : derrière un reverse proxy
FORWARD_HEADERS_STRATEGY=native
